# Copier ce fichier en .env puis remplir les valeurs. Ne jamais commiter .env.

# OpenRouter (rédaction des articles)
OPENROUTER_API_KEY=
# Modèle par défaut (facultatif : modifiable ensuite dans Réglages, Rédaction automatique)
OPENROUTER_MODEL=

# WordPress (API REST + mot de passe d'application, voir README)
WP_BASE_URL=https://citylock.fr
WP_USER=
WP_APP_PASSWORD=

# PageSpeed Insights (optionnelle : sans clé, le critère vitesse n'est pas mesuré)
PAGESPEED_API_KEY=

# Accès au tableau de bord (identifiant et mot de passe choisis par vous, à saisir dans l'hébergeur, jamais dans le code)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -hex 32)
SESSION_SECRET=

# Optionnel
# PORT=3000
# DATA_DIR=./data
# SUPPORT_CONTACT=Nom et email de la personne à contacter (affiché dans l'aide)
# SIMULATE=true   # simule OpenRouter et WordPress (aucun appel externe), pour tester
